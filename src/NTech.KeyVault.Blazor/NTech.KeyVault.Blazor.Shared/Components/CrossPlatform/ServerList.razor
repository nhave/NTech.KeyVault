@inject IFormFactor FormFactor
@inject IAuthService AuthService
@inject IActiveServerService ActiveServerService
@inject NavigationManager NavigationManager

@if (FormFactor.IsMobile)
{
    <AddServerModal @ref="addServerModal" OnServerAdded="AddServer" />

    @* <p>This is a mobile device.</p>
    <p>Servers: @servers.Count()</p>
    <p>Active Server: @(activeServer?.Host ?? "None")</p> *@

    @if (showLogin)
    {
        <Login OnLoginSuccess="OnLoginSuccess" OnLoginCancel="OnLoginCancel" ServerInfo="selectedServer" />
    }
    else
    {
        <div class="card">
            <h1 class="card-header">Servers</h1>
            <div class="card-body">
                <button class="btn btn-primary mb-3" @onclick="() => addServerModal.ShowAsync()">Add Server</button>
                <div class="list-group">
                    @foreach (var server in servers)
                    {
                        <div class="list-group-item list-group-item-action @(activeServer?.Id == server.Id ? "active" : "")" @onclick="() => OnItemSelected(server)">
                            <span>@server.Name (@server.Host)</span>
                            <button class="btn btn-sm btn-danger" @onclick="() => RemoveServer(server)" @onclick:stopPropagation>Remove</button>
                        </div>
                    }
                </div>
            </div>
        </div>
    }
}
else
{
    <Login OnLoginSuccess="OnLoginSuccess" />
}

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private AddServerModal addServerModal = default!;

    private List<ServerInfo> servers = new();
    private ServerInfo? activeServer;
    private ServerInfo? selectedServer;
    private bool showLogin = false;

    protected override async Task OnInitializedAsync()
    {
        servers = AuthService.LoadServers();
        activeServer = ActiveServerService.GetActiveServer();
    }

    private async Task AddServer((string name, string host) server)
    {
        AuthService.AddServer(server.name, server.host);
        servers = AuthService.LoadServers();
    }

    private async Task RemoveServer(ServerInfo server)
    {
        await AuthService.RemoveServer(server.Id);
        servers = AuthService.LoadServers();
        if (activeServer?.Id == server.Id)
        {
            await ClearActiveServer();
            NavigationManager.NavigateTo(NavigationManager.Uri, forceLoad: true, replace: true);
        }
    }

    private async Task OnItemSelected(ServerInfo server)
    {
        if (activeServer?.Id == server.Id)
            return;

        selectedServer = server;

        if (await AuthService.HasTokensAsync(selectedServer.Id))
        {
            await OnLoginSuccess();
            return;
        }

        showLogin = true;
    }

    private async Task OnLoginSuccess()
    {
        if (selectedServer != null)
        {
            await SetActiveServer(selectedServer);
            showLogin = false;
            NavigationManager.NavigateTo(NavigationManager.Uri, forceLoad: true, replace: true);
        }
    }

    private void OnLoginCancel()
    {
        showLogin = false;
    }

    private async Task SetActiveServer(ServerInfo server)
    {
        await ActiveServerService.SetActiveServer(server);
        activeServer = server;
    }

    private async Task ClearActiveServer()
    {
        await ActiveServerService.ClearActiveServer();
        activeServer = null;
    }
}